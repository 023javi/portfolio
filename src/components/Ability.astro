---
interface Props {
    name: string;
    image: string;
}

const { name, image } = Astro.props;
---

<div
    class="group flex flex-col items-center justify-center gap-3
    w-24 h-24
    border border-white/10
    bg-white/[0.02]
    rounded-2xl
    transition-all duration-300
    hover:-translate-y-1
    hover:border-blue-400/40
    hover:bg-blue-500/5
    hover:shadow-[0_10px_30px_rgba(59,130,246,0.12)]"
>
    <img
        src={image}
        alt={name}
        class="w-9 h-9 object-contain
        transition-transform duration-300
        group-hover:scale-110"
    />

    <span
        class="text-gray-300 text-sm font-medium
        transition-colors duration-300
        group-hover:text-white"
    >
        {name}
    </span>
</div>
