---
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href="/favicon-16x16.png"
		/>
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio de Javier de la Cruz</title>
	</head>

	<body class="relative min-h-screen bg-neutral-950 text-[#e8e8e8]">
		<!-- Fondo -->
		<div
			class="fixed inset-0 -z-10 bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(0,0,180,0.3),rgba(255,255,255,0))]"
		>
		</div>

		<!-- Contenido -->
		<div class="relative z-10">
			<Header />

			<main>
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
