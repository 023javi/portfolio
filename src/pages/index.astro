---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Timeline from "../components/Timeline.astro";
import IconBag from "../components/icons/bag.svg";
import IconFolder from "../components/icons/folder.svg";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import IconPhone from "../components/icons/phone.svg";
import Footer from "../components/Footer.astro";
import Habilities from "../components/Habilities.astro";
import "../styles/global.css";
---

<Layout title="Javi Developer">
	<section
		class="w-full max-w-[1000px] mx-auto px-5 sm:px-6 lg:px-0 pt-28 sm:pt-32 pb-16"
	>
		<section id="about" class="mb-5 scroll-mt-20">
			<Hero />
		</section>

		<section id="experience" class="my-15 w-full scroll-mt-20">
			<h1
				class="text-white font-bold text-3xl mb-5 flex flex-row items-center gap-2"
			>
				<IconBag /> Experiencia Laboral
			</h1>
			<Timeline />
		</section>

		<section id="projects" class="my-15 w-full scroll-mt-20">
			<h1
				class="text-white font-bold text-3xl mb-5 flex flex-row items-center gap-2"
			>
				<IconFolder /> Proyectos
			</h1>

			<Projects />
		</section>

		<section id="habilidades" class="w-full scroll-mt-20">
			<h1
				class="text-white font-bold text-3xl mb-5 flex flex-row items-center gap-2"
			>
				<IconFolder /> Habilidades
			</h1>

			<Habilities />
		</section>

		<section id="contact" class="my-15 w-full scroll-mt-20">
			<h1
				class="text-white font-bold text-3xl mb-5 flex flex-row items-center gap-2"
			>
				<IconPhone /> Contacto
			</h1>

			<Contact />
		</section>

		<Footer />
	</section>
</Layout>
